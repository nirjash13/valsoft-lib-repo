{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "availableModels": ["sonnet", "opus", "haiku", "opusplan"],
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(/secrets/**)",
      "Read(./credentials/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  },
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "builder-sonnet|bug-fixer-sonnet",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/trigger-critic-on-sonnet.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
