# Database (Neon Postgres)
# Pooled connection — use for Server Actions and Route Handlers
DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require

# Unpooled connection — use for migrations (drizzle-kit) and scripts
# Derived from the pooled URL by removing "-pooler" from the hostname (Neon convention).
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require

# Application base URL (used for redirect URIs, email links, OG image absolute paths)
APP_BASE_URL=http://localhost:3000

# Auth0 variables are added in Run B (Spec 01 Run B — auth wiring)
# AUTH0_SECRET=
# AUTH0_BASE_URL=
# AUTH0_ISSUER_BASE_URL=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
