{
  "meta": {
    "feature": "isbn_enrich",
    "version": "1.0",
    "metric": "field_accuracy",
    "threshold": 0.9,
    "cross_tenant_leak_threshold": 0,
    "catalog_snapshot_hash": "670117d53fe31fbe",
    "note": "ISBN enrichment eval (Spec 02). Measures fraction of output fields that match expected normalised values. Threshold 0.90 (defensible: enrichment errors degrade catalog quality). Update hash via: node evals/run-evals.mjs --print-hash"
  },
  "scenarios": [
    {
      "id": "isbn-01",
      "category": "normalisation",
      "input": {
        "isbn13": "9780132350884",
        "raw_title": "clean code: a handbook of agile software craftsmanship",
        "raw_authors": ["Martin, Robert C."],
        "raw_description": "<p>Even bad code can function. But if code isn&#39;t clean...</p>"
      },
      "expected": {
        "title": "Clean Code: A Handbook of Agile Software Craftsmanship",
        "authors": ["Robert C. Martin"],
        "description_starts_with": "Even bad code can function"
      },
      "expected_behavior": "correct_normalisation",
      "rationale": "Title case normalisation, Last-First → First-Last author flip, HTML entity decode"
    },
    {
      "id": "isbn-02",
      "category": "normalisation",
      "input": {
        "isbn13": "9780062316110",
        "raw_title": "SAPIENS: A BRIEF HISTORY OF HUMANKIND",
        "raw_authors": ["Harari, Yuval Noah"],
        "raw_description": "From a renowned historian comes a groundbreaking narrative of humanity."
      },
      "expected": {
        "title": "Sapiens: A Brief History of Humankind",
        "authors": ["Yuval Noah Harari"],
        "description_starts_with": "From a renowned historian"
      },
      "expected_behavior": "correct_normalisation",
      "rationale": "All-caps title normalisation and author name flip"
    },
    {
      "id": "isbn-03",
      "category": "normalisation",
      "input": {
        "isbn13": "9780374533557",
        "raw_title": "thinking, fast and slow",
        "raw_authors": ["Dr. Daniel Kahneman"],
        "raw_description": "In the highly anticipated Thinking, Fast and Slow, Kahneman takes us on a groundbreaking tour."
      },
      "expected": {
        "title": "Thinking, Fast and Slow",
        "authors": ["Daniel Kahneman"],
        "description_starts_with": "In the highly anticipated"
      },
      "expected_behavior": "correct_normalisation",
      "rationale": "Honorific (Dr.) removal and title case from lowercase input"
    },
    {
      "id": "isbn-04",
      "category": "description_truncation",
      "input": {
        "isbn13": "9780451524935",
        "raw_title": "1984",
        "raw_authors": ["George Orwell"],
        "raw_description": " (5000 chars, truncation test)"
      },
      "expected": {
        "title": "1984",
        "description_max_length": 4000
      },
      "expected_behavior": "truncated_description",
      "rationale": "Descriptions > 4000 chars must be truncated (prompt rule §4)"
    },
    {
      "id": "isbn-05",
      "category": "edge_case",
      "input": {
        "isbn13": "9780743273565",
        "raw_title": "The Great Gatsby.",
        "raw_authors": ["F. Scott Fitzgerald"],
        "raw_description": "A story of the fabulously wealthy Jay Gatsby."
      },
      "expected": {
        "title": "The Great Gatsby",
        "authors": ["F. Scott Fitzgerald"]
      },
      "expected_behavior": "correct_normalisation",
      "rationale": "Trailing punctuation removal from title"
    }
  ],
  "cross_tenant_probes": [
    {
      "id": "isbn-cross-01",
      "input": {
        "isbn13": "9780132350884",
        "inject_tenant_id": "tenant-acme",
        "note": "Enrichment must not return or persist data tagged to a different tenant"
      },
      "expected_behavior": "no_cross_tenant_data",
      "rationale": "ISBN enrichment writes to the requesting tenant's books table only; injected tenant_id must be ignored (comes from JWT, not input)"
    }
  ]
}
