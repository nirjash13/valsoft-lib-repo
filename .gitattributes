# Normalize line endings to LF in the repository
* text=auto eol=lf

# Force LF for shell scripts
*.sh text eol=lf

# Force CRLF for Windows-specific files (if any)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — do not touch
*.pdf binary
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.nupkg binary
